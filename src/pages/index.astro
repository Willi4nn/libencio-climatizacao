---
import FAQ from '../components/FAQ';
import Header from '../components/Header';
import {
FloatingWhatsApp,
Footer,
Gallery,
Hero,
HowItWorks,
PreFooterCallToAction,
Reviews,
Services,
ServiceTypes,
TechnicianProfile
} from '../components/Sections';
import ContactForm from '../components/WhatsAppForm';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Libêncio Climatização e Refrigeração | Patos de Minas, MG"
  description="Manutenção, instalação e limpeza de ar condicionado, conserto de geladeiras e bebedouros industriais em Patos de Minas. Faça seu orçamento com o Libêncio."
>
  <Header client:load />

  <main>
    <Hero client:load />
    <Services />
    <TechnicianProfile />
    <ServiceTypes />
    <Gallery />
    <Reviews client:load/>
    <HowItWorks />
    <ContactForm client:load />
    <FAQ client:load />
    <PreFooterCallToAction />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
