---
import FAQ from '../components/FAQ';
import Header from '../components/Header';
import {
ServiceTypes,
Reviews,
HowItWorks,
FloatingWhatsApp,
Footer,
Gallery,
Hero,
PreFooterCallToAction,
TechnicianProfile,
Services
} from '../components/Sections';
import ContactForm from '../components/WhatsAppForm';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Libêncio Refrigeração e Climatização | Patos de Minas"
  description="Conserto de geladeira, freezer, cervejeira e ar-condicionado a domicílio em Patos de Minas - MG. Segunda a sábado, das 8h às 18h."
>
  <Header client:load />

  <main>
    <Hero client:load />
    <Services />
    <TechnicianProfile />
    <ServiceTypes />
    <Gallery />
    <Reviews client:load/>
    <HowItWorks />
    <ContactForm client:load />
    <FAQ client:load />
    <PreFooterCallToAction />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
